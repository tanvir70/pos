# ============================================================================
# Al-Amin POS & Inventory System - Environment Template
# Duplicate this file as .env and fill in production credentials
# ============================================================================

APP_NAME="Al-Amin POS & Inventory System"
ENV=production
ENVIRONMENT=production
DEBUG=False
PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3

# Database configuration:
# Local development (SQLite default):
# DATABASE_URL=sqlite+aiosqlite:///./pos.db
# SYNC_DATABASE_URL=sqlite:///./pos.db

# Production cPanel MySQL / MariaDB (uncomment & set credentials):
# DATABASE_URL=mysql+aiomysql://cpanel_user:cpanel_password@localhost:3306/cpanel_posdb
# SYNC_DATABASE_URL=mysql+pymysql://cpanel_user:cpanel_password@localhost:3306/cpanel_posdb

# Security & Authentication (Generate random 32+ character key):
JWT_SECRET=ReplaceWithA32CharOrLongerSecretKeyForHmacSha256
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
TIMEZONE=Asia/Dhaka

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:8443","http://localhost:5173","http://localhost:3000","https://yourdomain.com"]
